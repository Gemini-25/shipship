<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <RootNamespace>ShipSim</RootNamespace>
    <!-- 새 엔진 판의 그리기(ShipView)도 옛 도트 화가 파일을 함께 싣는다 — 같은 이름은 이 프로젝트의 것을 쓴다 -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- 새 엔진 판 (scenes/NewEngine.tscn · src/NewEngine): 세계 engine/ShipEngine · 연출과 그리기 engine/ShipView -->
    <ProjectReference Include="../engine/ShipView/ShipView.csproj" />
  </ItemGroup>
</Project>
