// ⑧ · ⑩ 판단 엔진 — 지식 표 (docs/ENGINE.md 판단 엔진)
//   domains: 분야 — 상식은 모두가 안다 · 나머지는 사람마다 아는 정도(0~1, 맡은 일의 시작값은 사람 표 roles.knows)
//   principles: 원리 — 분야 · 문턱(그 분야를 이만큼 넘게 알아야 안다) · 글. 뜻(행동이 그림을 어떻게 바꾸나)은 코드의 풀이 법칙 (Mind/Solver.cs)
//   actions: 행동 — 누가(body: 그 자리에 간 몸 · computer: 주컴퓨터가 멀리서 · any: 둘 다) · 분야 · 쓰는 원리 · 걸리는 분 · 글({문} {방} {너머} — 조사는 {문을} {너머로}처럼 안에)
//     쓰는 원리를 모르면 그 행동을 떠올리지 못한다 (needs) · 막는 원리를 모르면 막히는 줄 모르고 해 본다 (limits)
//   manual: 기본 비상 절차서 — 출발 때 기관이 준 것 (목표마다 먼저 해 볼 방법 차례) · 배마다 회의로 고친다
{
  "domains": [ "상식", "기압", "전기", "화학", "몸", "구조" ],
  "principles": {
    "열린문":     { "domain": "상식", "need": 0,    "text": "열린 문 양쪽은 기압이 같아진다 — 한쪽이 우주로 트였으면 이쪽 공기도 빠져나간다" },
    "트인방":     { "domain": "상식", "need": 0,    "text": "우주로 트인 방은 기압이 0으로 간다" },
    "숨":         { "domain": "상식", "need": 0,    "text": "우주복 없이 옅은 공기에 있으면 쓰러진다" },
    "끼인문":     { "domain": "상식", "need": 0,    "text": "끼인 문은 열리지 않는다" },
    "기압차문":   { "domain": "기압", "need": 0.3,  "text": "기압 차가 큰 문은 열리지 않는다 (전동 문 30kPa · 바깥문 5kPa · 전기 없는 문 2kPa)" },
    "밸브":       { "domain": "기압", "need": 0.4,  "text": "문의 압력 맞춤 밸브로 두 쪽 기압을 맞출 수 있다 — 너머가 우주로 트였으면 밸브가 열리지 않는다" },
    "되돌리기":   { "domain": "기압", "need": 0.6,  "text": "닫힌 방의 공기는 통풍구 펌프로 예비 탱크에 되돌릴 수 있다 — 느리고 20kPa 아래로는 못 뺀다" },
    "채우기":     { "domain": "기압", "need": 0.3,  "text": "닫힌 방은 예비 공기로 다시 채울 수 있다" },
    "바로잡기":   { "domain": "구조", "need": 0.3,  "text": "끼인 문은 틀을 비틀어 바로잡으면 다시 움직인다" },
    "구멍막기":   { "domain": "구조", "need": 0.2,  "text": "외판 구멍은 안에서든 선체 바깥에서든 봉합 꾸러미로 막을 수 있다" },
    "공기냉각":   { "domain": "전기", "need": 0.4,  "text": "공기가 빠진 방의 장치는 공기로 식지 못해 뜨거워진다 — 주컴퓨터는 멈춘다" },
    "문틈":       { "domain": "기압", "need": 0.3,  "text": "보통 문은 닫혀도 틈으로 샌다 — 틈을 봉합 꾸러미로 막으면 멎는다 (문을 열면 떨어진다) · 압력 문은 새지 않는다" }
  },
  "actions": {
    "open":   { "who": "any",      "domain": "상식", "needs": [ "열린문" ], "limits": [ "기압차문", "끼인문", "밸브", "공기냉각" ], "minutes": 0.3, "text": "{문을} 연다" },
    "close":  { "who": "any",      "domain": "상식", "needs": [], "limits": [], "minutes": 0.3, "text": "{문을} 닫는다" },
    "go":     { "who": "body",     "domain": "상식", "needs": [], "limits": [ "숨" ], "minutes": 1, "text": "{문을} 지나 {너머로} 간다" },
    "unjam":  { "who": "body",     "domain": "구조", "needs": [ "바로잡기" ], "limits": [], "minutes": 4, "text": "끼인 {문을} 바로잡는다" },
    "pump":   { "who": "computer", "domain": "기압", "needs": [ "되돌리기" ], "limits": [ "숨", "공기냉각", "문틈" ], "minutes": 0, "text": "{방} 공기를 예비 탱크로 되돌린다" },
    "fill":   { "who": "computer", "domain": "기압", "needs": [ "채우기" ], "limits": [], "minutes": 0, "text": "{방을} 예비 공기로 채운다" },
    "clear":  { "who": "computer", "domain": "상식", "needs": [], "limits": [], "minutes": 3, "text": "{방}의 사람을 옆 방으로 내보낸다" },
    "patch":  { "who": "body",     "domain": "구조", "needs": [ "구멍막기" ], "limits": [ "숨" ], "minutes": 4, "text": "{방} 외판 구멍을 막는다" },
    "tape":   { "who": "body",     "domain": "구조", "needs": [ "문틈" ], "limits": [], "minutes": 3, "text": "{문} 틈을 봉합 꾸러미로 막는다" },
    "seal":   { "who": "body",     "domain": "구조", "needs": [ "문틈" ], "limits": [], "minutes": 0, "text": "{방} 문을 모두 닫고 틈을 막는다" }
  },
  "manual": {
    "구멍": { "text": "외판 구멍 막기", "methods": [ "안에서", "바깥에서" ] },
    "샘":   { "text": "새는 곳 찾기", "methods": [ "안에서", "바깥에서" ] }
  }
}
