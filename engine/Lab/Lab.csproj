<Project Sdk="Microsoft.NET.Sdk">
  <!-- 실험실: 법칙 시험 · 규칙 시험 · 관찰 장면 · 재미 측정 · 성능 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Lab</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ShipEngine/ShipEngine.csproj" />
    <ProjectReference Include="../ShipView/ShipView.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- PNG 쓰개는 화면 쪽으로 옮겼다 (정점 사진 · 사진첩 — docs/OBSERVER.md §4.4) · 실험실은 그것을 쓴다 -->
    <Using Include="ShipView.Png" Alias="Png" />
  </ItemGroup>
</Project>
